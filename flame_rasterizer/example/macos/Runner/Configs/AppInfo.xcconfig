// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = $(APP_FILE_NAME)

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID)

// The team that signs the app, if any, and its identity: "-" signs it to run
// locally, which ignores the team, so tool/build_standalone.py sets Apple
// Development with a team.
DEVELOPMENT_TEAM = $(APP_TEAM_ID)
CODE_SIGN_IDENTITY = $(APP_SIGN_IDENTITY)
APP_SIGN_IDENTITY = -

// The Hardened Runtime, which notarization needs: tool/build_standalone.py
// turns it on for archives only.
ENABLE_HARDENED_RUNTIME = $(APP_HARDENED_RUNTIME)
APP_HARDENED_RUNTIME = NO

// A standalone game's own id suffix, name and app file name (without .app),
// so that it installs beside the example, the whole bundle id that can
// replace the example's, and the team that signs it: tool/build_standalone.py
// sets them through FLUTTER_XCODE_ build settings.
APP_ID_SUFFIX =
APP_BUNDLE_ID = dev.rasterizer.flameRasterizerExample$(APP_ID_SUFFIX)
APP_TEAM_ID =
APP_DISPLAY_NAME = Flame Rasterizer Example
APP_FILE_NAME = flame_rasterizer_example

// A standalone game's own app icon, a set in Runner's Assets.xcassets that
// tool/build_standalone.py sets too.
APP_ICON_NAME = AppIcon

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 dev.rasterizer. All rights reserved.
